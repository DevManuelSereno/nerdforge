{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NerdForge",
  "version": "0.1.0",
  "identifier": "com.manuel.nerdforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NerdForge",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/syncthing.exe": "./syncthing.exe"
    },
    "publisher": "Manuel",
    "copyright": "© 2026 Manuel. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "Hub desktop para criadores de RPG e worldbuilding",
    "longDescription": "NerdForge é um hub desktop para criadores de RPG, worldbuilding e escrita criativa. Gerencie NPCs, lore, facções e locais com geração assistida por IA, sincronização via Syncthing e integração com Obsidian.",
    "nsis": {
      "installerIcon": "icons/icon.ico",
      "installMode": "perMachine",
      "languages": ["pt-BR", "en-US"],
      "displayLanguageSelector": true
    },
    "windows": {
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
